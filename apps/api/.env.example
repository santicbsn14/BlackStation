# development | test | production
NODE_ENV=development
PORT=3000
# Atlas: base blackstation-dev para desarrollo.
MONGODB_URI=mongodb+srv://usuario:password@cluster0.example.mongodb.net/blackstation-dev
# Mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres
# Clave compartida con el print server (header X-Print-Key). Mínimo 32 caracteres.
PRINT_KEY=cambiar-por-una-clave-de-al-menos-32-caracteres
# Orígenes permitidos, separados por comas.
CORS_ORIGINS=http://localhost:5173
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=cambiar
# true = ignora los horarios (para desarrollar de día). Prohibido con NODE_ENV=production.
FORCE_OPEN=false

# Solo el seed (npm run seed -w @blackstation/api).
SEED_ADMIN_USUARIO=admin
SEED_ADMIN_PASSWORD=cambiar
SEED_ADMIN_NOMBRE=Black Station
