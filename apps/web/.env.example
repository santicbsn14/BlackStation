# Base URL de la API (sin barra final). Se ignora si VITE_USE_MOCKS=true.
VITE_API_URL=http://localhost:3000
# true = usa services/mocks en lugar de la API.
VITE_USE_MOCKS=true
# Solo mocks: ignora los horarios y genera franjas desde ahora hasta +3 h.
VITE_MOCK_FORCE_OPEN=true
# Solo mocks: con el panel abierto, simula un pedido cada 30–60 s.
VITE_MOCK_SIMULAR=false
